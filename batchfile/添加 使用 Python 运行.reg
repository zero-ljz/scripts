Windows Registry Editor Version 5.00

[HKEY_CLASSES_ROOT\*\shell\RunPyDirect]
@="使用 Python 运行..."
"Icon"="py.exe"
"AppliesTo"="System.FileExtension:=\".py\" OR System.FileExtension:=\".pyw\""
"MultiSelectModel"="Single"
"Script0"="& { Add-Type -AssemblyName System.Windows.Forms; Add-Type -AssemblyName System.Drawing; $f=[Environment]::GetCommandLineArgs()[-1]; if(!(Test-Path -LiteralPath $f -PathType Leaf)){[Windows.Forms.MessageBox]::Show('所选文件不存在。','运行 Python')|Out-Null; exit}; $dir=[IO.Path]::GetDirectoryName([IO.Path]::GetFullPath($f)); $items=New-Object Collections.ArrayList; $seen=New-Object 'Collections.Generic.HashSet[string]' ([StringComparer]::OrdinalIgnoreCase); $add={param($label,$exe) if([string]::IsNullOrWhiteSpace($exe)){return}; try{$full=(Get-Item -LiteralPath $exe -ErrorAction Stop).FullName}catch{return}; if($seen.Add($full)){[void]$items.Add([pscustomobject]@{Label=$label;Exe=$full})}}; $addVenv={param($root) if([string]::IsNullOrWhiteSpace($root)){return}; $cfg=Join-Path $root 'pyvenv.cfg'; $conda=Join-Path $root 'conda-meta';"
"Script1"=" if(!(Test-Path -LiteralPath $cfg -PathType Leaf) -and !(Test-Path -LiteralPath $conda -PathType Container)){return}; $exe=Join-Path $root 'Scripts\\python.exe'; if(!(Test-Path -LiteralPath $exe -PathType Leaf)){$exe=Join-Path $root 'bin\\python.exe'}; $name=Split-Path $root -Leaf; if([string]::IsNullOrWhiteSpace($name)){$name=$root}; &$add ('虚拟环境：'+$name+' — '+$root) $exe}; &$addVenv $env:VIRTUAL_ENV; &$addVenv $env:CONDA_PREFIX; $d=New-Object IO.DirectoryInfo($dir); $level=0; while($d -and $level -lt 6){&$addVenv $d.FullName; foreach($n in @('.venv','venv','env','.env')){&$addVenv (Join-Path $d.FullName $n)}; $stop=(Test-Path -LiteralPath (Join-Path $d.FullName '.git')) -or (Test-Path -LiteralPath (Join-Path $d.FullName 'pyproject.toml')) -or (Test-Path -LiteralPath (Join-Path $d.FullName 'setup.py'));"
"Script2"=" if($level -eq 0 -or $stop){Get-ChildItem -LiteralPath $d.FullName -Directory -Force -ErrorAction SilentlyContinue | Where-Object {Test-Path -LiteralPath (Join-Path $_.FullName 'pyvenv.cfg') -PathType Leaf} | ForEach-Object {&$addVenv $_.FullName}}; if($stop){break}; $d=$d.Parent; $level++}; $py=Get-Command py.exe -CommandType Application -ErrorAction SilentlyContinue | Select-Object -First 1; if($py){& $py.Source -0p 2>$null | ForEach-Object {$line=[string]$_; $m=[regex]::Match($line,'(?i)(?<path>[A-Z]:\\\\.*?python(?:w)?\\.exe)\\s*$'); if($m.Success){$version=$line.Substring(0,$m.Index).Trim().TrimStart('-').Replace('*','').Trim(); &$add ('全局 Python '+$version+' — '+$m.Groups['path'].Value) $m.Groups['path'].Value}}};"
"Script3"=" foreach($base in @('HKCU:\\Software\\Python\\PythonCore','HKLM:\\Software\\Python\\PythonCore','HKLM:\\Software\\WOW6432Node\\Python\\PythonCore')){Get-ChildItem -LiteralPath $base -ErrorAction SilentlyContinue | ForEach-Object {$version=$_.PSChildName; $ip=Get-Item -LiteralPath (Join-Path $_.PSPath 'InstallPath') -ErrorAction SilentlyContinue; if($ip){$exe=$ip.GetValue('ExecutablePath'); if([string]::IsNullOrWhiteSpace($exe)){$root=$ip.GetValue(''); if($root){$exe=Join-Path $root 'python.exe'}}; &$add ('全局 Python '+$version+' — '+$exe) $exe}}}; Get-Command -Name @('python.exe','python3.exe') -CommandType Application -All -ErrorAction SilentlyContinue | ForEach-Object {&$add ('PATH：'+$_.Source) $_.Source}; $form=New-Object Windows.Forms.Form; $form.Text='运行 Python'; $form.StartPosition='CenterScreen'; $form.ClientSize=New-Object Drawing.Size(740,365); $form.FormBorderStyle='FixedDialog';"
"Script4"=" $form.MaximizeBox=$false; $form.MinimizeBox=$false; $form.TopMost=$true; $form.AutoScaleMode='Dpi'; $envLabel=New-Object Windows.Forms.Label; $envLabel.Text='Python 环境：'; $envLabel.AutoSize=$true; $envLabel.Location=New-Object Drawing.Point(15,17); $form.Controls.Add($envLabel); $envBox=New-Object Windows.Forms.ComboBox; $envBox.Location=New-Object Drawing.Point(105,13); $envBox.Size=New-Object Drawing.Size(535,25); $envBox.DropDownStyle='DropDownList'; $envBox.DisplayMember='Exe'; foreach($item in $items){[void]$envBox.Items.Add($item)}; if($envBox.Items.Count -gt 0){$envBox.SelectedIndex=0}; $form.Controls.Add($envBox); $browse=New-Object Windows.Forms.Button; $browse.Text='浏览...'; $browse.Location=New-Object Drawing.Point(650,12); $browse.Size=New-Object Drawing.Size(75,27); $browse.Add_Click({$pick=New-Object Windows.Forms.OpenFileDialog; $pick.Title='选择 Python 解释器';"
"Script5"=" $pick.Filter='Python 解释器 (python.exe)|python.exe|可执行文件 (*.exe)|*.exe'; if($pick.ShowDialog() -eq 'OK'){&$add ('自定义：'+$pick.FileName) $pick.FileName; $new=$items[$items.Count-1]; if($envBox.Items.IndexOf($new) -lt 0){[void]$envBox.Items.Add($new)}; $envBox.SelectedItem=$new}}); $form.Controls.Add($browse); $label=New-Object Windows.Forms.Label; $label.Text='脚本路径：'; $label.AutoSize=$true; $label.Location=New-Object Drawing.Point(15,55); $form.Controls.Add($label); $tb=New-Object Windows.Forms.TextBox; $tb.Location=New-Object Drawing.Point(15,78); $tb.Size=New-Object Drawing.Size(710,58); $tb.Multiline=$true; $tb.ScrollBars='Vertical'; $q=[char]34; $tb.Text=$q+$f+$q; $form.Controls.Add($tb); $wdLabel=New-Object Windows.Forms.Label; $wdLabel.Text='工作目录：'; $wdLabel.AutoSize=$true; $wdLabel.Location=New-Object Drawing.Point(15,155); $form.Controls.Add($wdLabel);"
"Script6"=" $wd=New-Object Windows.Forms.ComboBox; $wd.Location=New-Object Drawing.Point(90,151); $wd.Size=New-Object Drawing.Size(635,25); $wd.DropDownStyle='DropDown'; $wd.AutoCompleteMode='SuggestAppend'; $wd.AutoCompleteSource='ListItems'; $d=New-Object IO.DirectoryInfo($dir); while($d){[void]$wd.Items.Add($d.FullName); $d=$d.Parent}; $wd.Text=$dir; $form.Controls.Add($wd); $module=New-Object Windows.Forms.CheckBox; $module.Text='以模块方式执行 (-m)'; $module.AutoSize=$true; $module.Location=New-Object Drawing.Point(15,194); $form.Controls.Add($module); $admin=New-Object Windows.Forms.CheckBox; $admin.Text='以管理员身份运行'; $admin.AutoSize=$true; $admin.Location=New-Object Drawing.Point(185,194); $form.Controls.Add($admin); $keep=New-Object Windows.Forms.CheckBox; $keep.Text='运行结束后保持窗口'; $keep.AutoSize=$true; $keep.Checked=$true; $keep.Location=New-Object Drawing.Point(345,194); $form.Controls.Add($keep);"
"Script7"=" $hide=New-Object Windows.Forms.CheckBox; $hide.Text='隐藏窗口'; $hide.AutoSize=$true; $hide.Location=New-Object Drawing.Point(535,194); $form.Controls.Add($hide); $previewLabel=New-Object Windows.Forms.Label; $previewLabel.Text='实际执行内容：'; $previewLabel.AutoSize=$true; $previewLabel.Location=New-Object Drawing.Point(15,228); $form.Controls.Add($previewLabel); $preview=New-Object Windows.Forms.TextBox; $preview.Location=New-Object Drawing.Point(15,251); $preview.Size=New-Object Drawing.Size(710,55); $preview.Multiline=$true; $preview.ReadOnly=$true; $preview.TabStop=$false; $preview.WordWrap=$true; $preview.ScrollBars='Vertical'; $preview.BackColor=[Drawing.SystemColors]::Window; $form.Controls.Add($preview); $splitInput={param($value) $value=$value.Trim(); if($value.StartsWith([string][char]34)){$end=$value.IndexOf([char]34,1); if($end -lt 0){return $null};"
"Script8"=" return [pscustomobject]@{Path=$value.Substring(1,$end-1);Rest=$value.Substring($end+1)}}; $m=[regex]::Match($value,'^(?<path>\\S+)(?<rest>.*)$'); if(!$m.Success){return $null}; [pscustomobject]@{Path=$m.Groups['path'].Value;Rest=$m.Groups['rest'].Value}}; $resolveArgs={param($validate) $w=$wd.Text.Trim(); $input=$tb.Text.Trim(); if([string]::IsNullOrWhiteSpace($input)){return [pscustomobject]@{Error='脚本路径不能为空。';Args=''}}; if(!(Test-Path -LiteralPath $w -PathType Container)){return [pscustomobject]@{Error='工作目录不存在：'+[Environment]::NewLine+$w;Args=''}}; $part=&$splitInput $input; if($null -eq $part){return [pscustomobject]@{Error='无法识别脚本路径；路径包含空格时请使用双引号。';Args=''}}; $script=$part.Path; if(![IO.Path]::IsPathRooted($script)){$script=Join-Path $w $script}; try{$script=[IO.Path]::GetFullPath($script)}catch{return [pscustomobject]@{Error='脚本路径无效。';Args=''}};"
"Script9"=" if($validate -and !(Test-Path -LiteralPath $script -PathType Leaf)){return [pscustomobject]@{Error='脚本不存在：'+[Environment]::NewLine+$script;Args=''}}; if(!$module.Checked){return [pscustomobject]@{Error=$null;Args=$input}}; $base=[IO.Path]::GetFullPath($w).TrimEnd('\\')+'\\'; if(!$script.StartsWith($base,[StringComparison]::OrdinalIgnoreCase)){return [pscustomobject]@{Error='以模块方式执行时，脚本必须位于工作目录内。请选择脚本的包根目录或其上级目录作为工作目录。';Args=''}}; $relative=$script.Substring($base.Length); $ext=[IO.Path]::GetExtension($relative); $name=$relative.Substring(0,$relative.Length-$ext.Length).Replace('\\','.').Replace('/','.'); if($name.EndsWith('.__init__')){$name=$name.Substring(0,$name.Length-9)}; if([string]::IsNullOrWhiteSpace($name) -or ($name.Split('.') | Where-Object {$_ -notmatch '^[A-Za-z_]\\w*$'})){return [pscustomobject]@{Error='无法从脚本路径生成有效模块名：'+[Environment]::NewLine+$relative;Args=''}};"
"Script10"=" [pscustomobject]@{Error=$null;Args='-m '+$name+$part.Rest}}; $refreshPreview={if($null -eq $envBox.SelectedItem){$preview.Text='<未选择 Python 环境>'; return}; $resolved=&$resolveArgs $false; if($resolved.Error){$preview.Text='<'+$resolved.Error.Replace([Environment]::NewLine,' ')+'>'; return}; $pythonCommand=$q+$envBox.SelectedItem.Exe+$q+' '+$resolved.Args; $preview.Text=$pythonCommand}; $envBox.Add_SelectedIndexChanged({&$refreshPreview}); $tb.Add_TextChanged({&$refreshPreview}); $wd.Add_TextChanged({&$refreshPreview}); $module.Add_CheckedChanged({&$refreshPreview}); $admin.Add_CheckedChanged({&$refreshPreview}); $keep.Add_CheckedChanged({&$refreshPreview}); $hide.Add_CheckedChanged({if($hide.Checked){$keep.Checked=$false; $keep.Enabled=$false}else{$keep.Enabled=$true}; &$refreshPreview}); $ok=New-Object Windows.Forms.Button; $ok.Text='运行'; $ok.Location=New-Object Drawing.Point(550,325);"
"Script11"=" $ok.Add_Click({if($null -eq $envBox.SelectedItem){[Windows.Forms.MessageBox]::Show('未检测到 Python 环境，请单击“浏览...”选择 python.exe。','运行 Python')|Out-Null; return}; $resolved=&$resolveArgs $true; if($resolved.Error){[Windows.Forms.MessageBox]::Show($resolved.Error,'运行 Python')|Out-Null; return}; $form.Tag=[pscustomobject]@{Exe=$envBox.SelectedItem.Exe;Args=$resolved.Args;WorkingDirectory=$wd.Text.Trim();Admin=$admin.Checked;Keep=$keep.Checked;Hide=$hide.Checked}; $form.Close()}); $form.Controls.Add($ok); $cancel=New-Object Windows.Forms.Button; $cancel.Text='取消'; $cancel.Location=New-Object Drawing.Point(645,325); $cancel.Add_Click({$form.Close()}); $form.Controls.Add($cancel); $form.AcceptButton=$ok; $form.CancelButton=$cancel; $form.Add_Shown({&$refreshPreview; $tb.Focus();$tb.SelectAll();"
"Script12"=" if($envBox.Items.Count -eq 0){[Windows.Forms.MessageBox]::Show('未自动检测到 Python 环境。请单击“浏览...”选择 python.exe。','运行 Python')|Out-Null}}); $form.ShowDialog()|Out-Null; if($null -eq $form.Tag){exit}; $run=$form.Tag; $cmd=$q+$run.Exe+$q+' '+$run.Args; $psi=New-Object Diagnostics.ProcessStartInfo; $psi.WorkingDirectory=$run.WorkingDirectory; if($run.Hide){$psi.FileName=$run.Exe; $psi.Arguments=$run.Args; $psi.WindowStyle=[Diagnostics.ProcessWindowStyle]::Hidden; if($run.Admin){$psi.UseShellExecute=$true; $psi.Verb='runas'}else{$psi.UseShellExecute=$false; $psi.CreateNoWindow=$true}}else{$mode=if($run.Keep){'/d /s /k '}else{'/d /s /c '}; $psi.FileName=$env:ComSpec; $psi.Arguments=$mode+$q+$cmd+$q; $psi.UseShellExecute=$true; if($run.Admin){$psi.Verb='runas'}};"
"Script13"=" try{[Diagnostics.Process]::Start($psi)|Out-Null}catch{[Windows.Forms.MessageBox]::Show('启动失败或已取消：'+$_.Exception.Message,'运行 Python')|Out-Null} }"

[HKEY_CLASSES_ROOT\*\shell\RunPyDirect\command]
@="powershell.exe -NoProfile -STA -WindowStyle Hidden -Command \"& { $p='*/shell/RunPyDirect'.Replace('/',[char]92); $k=[Microsoft.Win32.Registry]::ClassesRoot.OpenSubKey($p); $s=$k.GetValue('Script0')+$k.GetValue('Script1')+$k.GetValue('Script2')+$k.GetValue('Script3')+$k.GetValue('Script4')+$k.GetValue('Script5')+$k.GetValue('Script6')+$k.GetValue('Script7')+$k.GetValue('Script8')+$k.GetValue('Script9')+$k.GetValue('Script10')+$k.GetValue('Script11')+$k.GetValue('Script12')+$k.GetValue('Script13'); & ([scriptblock]::Create($s)) };#\" \"%1\""
